library(DBI)
library(RPostgres)
usethis::edit_r_environ()
con <- dbConnect(
Postgres(),
host     = Sys.getenv("SUPABASE_HOST"),
port     = as.integer(Sys.getenv("SUPABASE_PORT")),
dbname   = Sys.getenv("SUPABASE_DB"),
user     = Sys.getenv("SUPABASE_USER"),
password = Sys.getenv("SUPABASE_PASSWORD"),
sslmode  = "require"
)
