# Si funciona, verás tus tablas:
dbListTables(con)
# Leer tabla completa
df <- dbReadTable(con, "lista")
head(df)
# O con una query SQL específica
df <- dbGetQuery(con, "SELECT * FROM lista LIMIT 10")
head(df)
shiny::runApp()
View(df)
